rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /generator/main {
      allow read: if true;
      allow create: if request.resource.data.revision == 1 && valid();
      allow update: if request.resource.data.revision == resource.data.revision + 1 && valid();
      function valid() {
        return request.resource.data.keys().hasOnly(['data','revision','updatedAt','lastMutationId'])
          && request.resource.data.data.keys().hasOnly(['settings','cabins','subscribers','transactions','invoices','openingCredits','ledgerVersion','closedThrough'])
          && request.resource.data.data.ledgerVersion == 2
          && (!('closedThrough' in request.resource.data.data) || request.resource.data.data.closedThrough is map)
          && request.resource.data.data.invoices is list
          && request.resource.data.data.openingCredits is map
          && request.resource.data.data.settings is map
          && request.resource.data.data.cabins is list
          && request.resource.data.data.subscribers is list
          && request.resource.data.data.transactions is list;
      }
    }
  }
}
